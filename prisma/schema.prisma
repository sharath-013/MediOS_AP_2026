// Same 7 tables as dbms/03_schema.sql (3NF / BCNF).
// CHECK constraints are not supported by Prisma; they are enforced
// here with enums and in the service layer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  INSURANCE
}

model Patient {
  id           Int           @id @default(autoincrement()) @map("patient_id")
  firstName    String        @map("first_name") @db.VarChar(50)
  lastName     String        @map("last_name") @db.VarChar(50)
  phone        String        @db.VarChar(15)
  email        String        @unique @db.VarChar(100)
  dateOfBirth  DateTime      @map("date_of_birth") @db.Date
  gender       Gender
  appointments Appointment[]

  @@map("patients")
}

model Department {
  id      Int      @id @default(autoincrement()) @map("department_id")
  name    String   @unique @map("department_name") @db.VarChar(80)
  doctors Doctor[]

  @@map("departments")
}

model Doctor {
  id             Int           @id @default(autoincrement()) @map("doctor_id")
  name           String        @map("doctor_name") @db.VarChar(100)
  specialization String        @db.VarChar(80)
  departmentId   Int           @map("department_id")
  department     Department    @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  appointments   Appointment[]

  @@map("doctors")
}

model Service {
  code         String        @id @map("service_code") @db.VarChar(10)
  name         String        @unique @map("service_name") @db.VarChar(100)
  listPrice    Decimal       @map("list_price") @db.Decimal(10, 2)
  invoiceItems InvoiceItem[]

  @@map("services")
}

model Appointment {
  id        Int               @id @default(autoincrement()) @map("appointment_id")
  date      DateTime          @map("appointment_date") @db.Date
  startTime DateTime          @map("start_time") @db.Time(6)
  status    AppointmentStatus @default(SCHEDULED)
  patientId Int               @map("patient_id")
  doctorId  Int               @map("doctor_id")
  patient   Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor    Doctor            @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  invoice   Invoice?

  @@unique([doctorId, date, startTime], map: "uq_doctor_slot")
  @@map("appointments")
}

model Invoice {
  invoiceNo     Int           @id @default(autoincrement()) @map("invoice_no")
  appointmentId Int           @unique @map("appointment_id")
  invoiceDate   DateTime      @default(now()) @map("invoice_date") @db.Date
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  paymentMethod PaymentMethod? @map("payment_method")
  appointment   Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  items         InvoiceItem[]

  @@map("invoices")
}

model InvoiceItem {
  invoiceNo    Int     @map("invoice_no")
  serviceCode  String  @map("service_code") @db.VarChar(10)
  quantity     Int     @default(1) @db.SmallInt
  chargedPrice Decimal @map("charged_price") @db.Decimal(10, 2)
  invoice      Invoice @relation(fields: [invoiceNo], references: [invoiceNo], onDelete: Cascade)
  service      Service @relation(fields: [serviceCode], references: [code], onDelete: Restrict)

  @@id([invoiceNo, serviceCode])
  @@map("invoice_items")
}
